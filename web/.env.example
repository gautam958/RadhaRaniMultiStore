# Google OAuth Web client ID (same value as Auth__GoogleClientId in the API)
VITE_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
# Shown on bills and used for the UPI payment QR at the counter
VITE_SHOP_NAME=Radha Rani Multi Store
VITE_SHOP_ADDRESS=Deoghar, Jharkhand
VITE_SHOP_PHONE=
VITE_SHOP_GSTIN=
VITE_UPI_ID=yourname@okaxis
# Leave empty locally (Vite proxies /api). In production set to your Function App URL, e.g. https://radharani-api.azurewebsites.net
VITE_API_BASE=
